# ==============================================================================
# AI Agent Environment Configuration
# ==============================================================================

# Core LLM Provider Settings
PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
MODEL_NAME=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
TEMPERATURE=0.7

# Storage Paths (Optional: Overridden automatically in Docker to /app/data/...)
# CHROMA_PATH=./chroma_db
# DATABASE_PATH=./chatbot.db

# Optional: LangSmith Observability & Tracing
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=learning_chat_bot
