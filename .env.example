# ==============================================================================
# AI Agent Environment Configuration
# ==============================================================================

# Core LLM Provider Selection
# Supported options: groq | openai | bedrock
PROVIDER=groq

# ------------------------------------------------------------------------------
# 1. Groq Configuration (Ultra-fast open-source LLM inference)
# ------------------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here
# Popular Groq models:
#   - openai/gpt-oss-20b (Fast, recommended default)
#   - qwen/qwen3.8-27b
#   - openai/gpt-oss-120b
#   - groq/compound-mini
MODEL_NAME=openai/gpt-oss-20b
TEMPERATURE=0.7


# ------------------------------------------------------------------------------
# 2. OpenAI Configuration
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# MODEL_NAME=gpt-4o-mini
# EMBEDDING_MODEL=text-embedding-3-small

# ------------------------------------------------------------------------------
# 3. Amazon Bedrock Configuration (AWS Bedrock Foundation Models)
# ------------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=your_aws_access_key_id_here
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
# AWS_REGION=us-east-1
# AWS_SESSION_TOKEN=
# Popular Bedrock models:
#   - anthropic.claude-3-5-sonnet-20240620-v1:0
#   - anthropic.claude-3-haiku-20240307-v1:0
#   - meta.llama3-70b-instruct-v1:0
#   - amazon.titan-text-premier-v1:0
# EMBEDDING_MODEL=amazon.titan-embed-text-v1

# ------------------------------------------------------------------------------
# Storage Paths (Overridden automatically in Docker to /app/data/...)
# ------------------------------------------------------------------------------
# CHROMA_PATH=./chroma_db
# DATABASE_PATH=./chatbot.db

# ------------------------------------------------------------------------------
# Optional: LangSmith Observability & Tracing
# ------------------------------------------------------------------------------
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=learning_chat_bot
